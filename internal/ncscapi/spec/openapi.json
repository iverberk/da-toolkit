  "paths": {
    "/v1/data-analyses": {
      "post": {
        "tags": [
          "v1",
          "data-analyses"
        ],
        "summary": "Create a data analysis",
        "description": "Create a new data analysis.\n\nThis endpoint initiates a data analysis process with the specified configuration.\n\nRate limit: 60 requests per hour per account.",
        "operationId": "create_data_analysis_v1_data_analyses_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreDataAnalysisRequest"
