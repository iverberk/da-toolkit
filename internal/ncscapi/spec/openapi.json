          "metadata",
          "processing_at",
          "completed_at",
          "expired_at",
          "created_at"
        ],
        "title": "DataAnalysisCollection",
        "description": "Transforms data analyses into a paginated API response format."
      },
      "DataAnalysisCreatedResource": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "type": {
            "$ref": "#/components/schemas/DataAnalysisType"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/DataAnalysisFileUploadResource"
            },
            "type": "array",
            "title": "Files"
          },
          "manual_analysis_allowed": {
            "type": "boolean",
            "title": "Manual Analysis Allowed"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "files",
          "manual_analysis_allowed",
          "metadata"
        ],
        "title": "DataAnalysisCreatedResource",
        "description": "Transforms a data analysis model into a standardized API response format."
      },
      "DataAnalysisFile": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_. \\-]+$",
            "title": "Name",
            "description": "Exact filename as it will be uploaded"
          },
          "aes_key": {
            "type": "string",
            "title": "Aes Key",
            "description": "AES-256-GCM encryption key (base64 encoded) for this file"
          },
          "hash": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_., \\-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hash",
            "description": "SHA-256 hash of the encrypted file"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "aes_key"
        ],
        "title": "DataAnalysisFile",
        "description": "Generic fields belonging to every data analysis file."
      },
      "DataAnalysisFileResource": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "completed"
            ],
            "title": "Status"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "results": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DataAnalysisResultResource"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Results",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "completed_at"
        ],
        "title": "DataAnalysisFileResource",
        "description": "Transforms a data analysis file into a standardized API response format."
      },
      "DataAnalysisFileUploadResource": {
