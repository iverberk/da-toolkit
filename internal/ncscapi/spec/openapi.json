      "get": {
        "tags": [
          "v1",
          "data-analyses"
        ],
        "summary": "Read all data analyses",
        "description": "Read all data analyses.\n\nThis endpoint retrieves details (status, files and results, etc.) of all data analyses.",
        "operationId": "read_data_analyses_v1_data_analyses_get",
        "parameters": [
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A JSON string representing filter conditions.",
              "title": "Filters"
            },
            "description": "A JSON string representing filter conditions."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "e.g. name:asc, role.name:desc, role__department__name:asc",
              "title": "Sort"
            },
            "description": "e.g. name:asc, role.name:desc, role__department__name:asc"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A string for global search. Searches only the root model's string/enum columns. To search related models, use search_fields parameter.",
              "title": "Search"
            },
            "description": "A string for global search. Searches only the root model's string/enum columns. To search related models, use search_fields parameter."
          },
          {
            "name": "search_fields",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated field names and nested paths to search (e.g., name,email,role.name,role.department.name). If specified, only these exact fields are searched (can include nested relationships). If not specified, only the root model's string/enum columns are searched (no relationships).",
              "title": "Search Fields"
            },
            "description": "Comma-separated field names and nested paths to search (e.g., name,email,role.name,role.department.name). If specified, only these exact fields are searched (can include nested relationships). If not specified, only the root model's string/enum columns are searched (no relationships)."
          },
          {
            "name": "case_sensitive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "When true, uses legacy case-sensitive behavior for string filters and string sorting. Default false applies case-insensitive behavior.",
              "default": false,
              "title": "Case Sensitive"
            },
            "description": "When true, uses legacy case-sensitive behavior for string filters and string sorting. Default false applies case-insensitive behavior."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size",
              "default": 50,
              "title": "Size"
            },
            "description": "Page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_DataAnalysisCollection_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/data-analyses/{data_analysis_id}": {
      "get": {
        "tags": [
          "v1",
          "data-analyses"
        ],
        "summary": "Read a data analysis",
        "description": "Read a data analysis.\n\nThis endpoint retrieves details (status, files and results, etc.) of the provided data analysis.\n\nRate limit: 6 requests per data analysis per minute per account.",
        "operationId": "read_data_analysis_v1_data_analyses__data_analysis_id__get",
        "parameters": [
          {
            "name": "data_analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Data Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataAnalysisResource"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "v1",
          "data-analyses"
        ],
        "summary": "Delete a data analysis",
        "description": "Delete a data analysis.\n\nThis endpoint deletes a data analysis and the corresponding source data.",
        "operationId": "delete_data_analysis_v1_data_analyses__data_analysis_id__delete",
        "parameters": [
          {
            "name": "data_analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Data Analysis Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Deletion request accepted. The data analysis is immediately represented as deleted, while the underlying data is deleted asynchronously in the background."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Deletion request could not be processed."
          }
        }
      }
    },
    "/v1/data-analyses/{data_analysis_id}/results/{file_name}": {
      "get": {
        "tags": [
          "v1",
          "data-analyses-results"
        ],
        "summary": "Retrieve a specific result file of the specified data analysis.",
        "description": "Retrieve a specific result file of the specified data analysis.\n\nThis endpoint retrieves the specified file corresponding to the provided data analysis from storage as binary data.\n\nRate limit: 12 requests per data analysis per minute per account.",
        "operationId": "data_analysis_get_result_v1_data_analyses__data_analysis_id__results__file_name__get",
        "parameters": [
          {
            "name": "data_analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Data Analysis Id"
            }
          },
          {
            "name": "file_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {},
              "application/csv": {},
              "application/pdf ": {},
              "application/json ": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {}
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/v1/data-analyses/{data_analysis_id}/results": {
      "post": {
        "tags": [
          "v1",
          "data-analyses-results"
        ],
        "summary": "Retrieve an archive with all results of the specified data analysis.",
        "description": "Retrieve an archive with all results of the specified data analysis.\n\nThis endpoint retrieves a ZIP archive with all results of the specified data analysis from storage as binary data.\n\nRate limit: 12 requests per data analysis per minute per account.",
        "operationId": "data_analysis_get_results_archive_v1_data_analyses__data_analysis_id__results_post",
        "parameters": [
          {
            "name": "data_analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Data Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationErrorResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {}
            },
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
